@using CleverWeb.Features.Auth.ViewModel
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card__header">
            <div class="brand-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1>Acesso ao Sistema</h1>
            <p>Entre com seu usuário e senha da igreja.</p>
        </div>

        <div class="auth-card__body">
            <form method="post" class="auth-form needs-validation" novalidate>
                <div class="form-floating mb-3">
                    <input asp-for="UserName" class="form-control" placeholder="Usuário" autocomplete="username" required />
                    <label asp-for="UserName"></label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Senha" type="password" class="form-control" placeholder="Senha" autocomplete="current-password" required />
                    <label asp-for="Senha"></label>
                </div>

                <button class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                </button>
            </form>

            <div asp-validation-summary="ModelOnly" class="auth-alert"></div>
        </div>
    </div>
</div>