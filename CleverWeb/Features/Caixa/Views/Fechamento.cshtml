@using CleverWeb.Features.Caixa.ViewModels
@using System.Globalization
@using static CleverWeb.Data.Shared.Enums
@model RelatorioMovimentoCaixaViewModel

@{
    ViewData["Title"] = "Fechamento de caixa";
    var filtro = ViewBag.Filtro as FiltroMovimentoCaixaViewModel;
    var totalEntradas = Model.Lista.Where(x => x.Tipo == "Entrada").Sum(x => x.Valor);
    var totalSaidas = Model.Lista.Where(x => x.Tipo == "Saída").Sum(x => Math.Abs(x.Valor));
    var saldoCaixa = totalEntradas - totalSaidas;
}


<div class="container py-4">

    <!-- Título -->
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-clipboard-data fs-3 text-primary me-2"></i>
        <h2 class="mb-0 fw-bold">Fechar caixa</h2>
    </div>

    <!-- Card Filtro -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Tipo</label>
                        <select asp-for="Filtro.TipoContribuicao"
                                asp-items="Html.GetEnumSelectList<TipoContribuicao>()"
                                class="form-select">
                            <option value="">Todos</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Data Inicial</label>
                        <input asp-for="Filtro.DataInicio" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Data Final</label>
                        <input asp-for="Filtro.DataFim" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i> Filtrar
                        </button>

                        <button type="button"
                                class="btn btn-danger w-100"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmarFechamentoModal"
                                disabled="@(!Model.Lista.Any())">
                            <i class="bi bi-lock me-1"></i> Fechar caixa
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Card Total -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <i class="bi bi-cash-coin fs-2 text-success me-3"></i>
                <div>
                    <div class="text-muted small">Total do Período</div>
                    <div class="fs-4 fw-bold text-success">
                        @saldoCaixa.ToString("C", new CultureInfo("pt-BR"))
                    </div>
                </div>
            </div>

            <span>
                @Model.Lista.Count() registro(s)
            </span>

        </div>
    </div>

    <div class="modal fade" id="confirmarFechamentoModal" tabindex="-1" aria-labelledby="confirmarFechamentoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-2">
                    <div>
                        <h5 class="modal-title fw-bold" id="confirmarFechamentoModalLabel">Confirmar fechamento</h5>
                        <small class="text-muted">Resumo do caixa antes de fechar</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body pt-2">
                    <div class="mb-3">
                        <div class="text-muted small">Período</div>
                        <div class="fw-semibold">
                            @if (Model.Filtro.DataInicio.HasValue || Model.Filtro.DataFim.HasValue)
                            {
                                @(Model.Filtro.DataInicio?.ToString("dd/MM/yyyy") ?? "Início")
                                <span class="mx-1">—</span>
                                @(Model.Filtro.DataFim?.ToString("dd/MM/yyyy") ?? "Hoje")
                            }
                            else
                            {
                                <span>Todo o período</span>
                            }
                        </div>
                    </div>

                    <div class="list-group list-group-flush rounded-3 overflow-hidden border">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Entradas</span>
                            <strong class="text-success">@totalEntradas.ToString("C", new CultureInfo("pt-BR"))</strong>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Saídas</span>
                            <strong class="text-danger">@totalSaidas.ToString("C", new CultureInfo("pt-BR"))</strong>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center bg-light">
                            <span>Saldo final</span>
                            <strong class="text-primary">@saldoCaixa.ToString("C", new CultureInfo("pt-BR"))</strong>
                        </div>
                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        Ao confirmar, o caixa será encerrado e os registros deste período serão vinculados ao fechamento atual.
                    </p>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>

                    <form asp-action="FecharCaixa" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Filtro.TipoContribuicao" />
                        <input type="hidden" asp-for="Filtro.DataInicio" />
                        <input type="hidden" asp-for="Filtro.DataFim" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-check-circle me-1"></i> Confirmar fechamento
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="list-group list-group-flush">
        @foreach (var item in Model.Lista)
        {
            <a class="list-group-item list-group-item-action py-3">

                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <!-- Nome do membro -->
                        <div class="fw-semibold text-dark">
                            @item.Origem
                        </div>

                        <!-- Detalhes -->
                        <small class="text-muted d-block">
                            @item.Descricao
                        </small>

                        <small class="text-muted">
                            <i class="bi bi-calendar3"></i>
                            @item.Data.ToString("dd/MM/yyyy")
                        </small>
                    </div>

                    <!-- Valor -->
                    <div class="text-end ms-3">
                        <span class="fw-bold @(item.Tipo == "Entrada" ? "text-success" : "text-danger")">
                            @item.Valor.ToString("C", new CultureInfo("pt-BR"))
                        </span>
                    </div>
                </div>
            </a>
        }
    </div>

</div>