@using CleverWeb.Features.Caixa.ViewModels
@using static CleverWeb.Data.Shared.Enums
@model IEnumerable<CaixaViewModel>

@{
    ViewData["Title"] = "Caixas";
}

<div class="page-shell">
    <header class="section-header">
        <div>
            <div class="section-header__eyebrow">
                <i class="bi bi-bank"></i>
                <span>Financeiro</span>
            </div>
            <h1 class="page-title">Histórico de movimentação do caixa</h1>
            <p class="section-header__description">Acompanhe os fechamentos por período e tipo de caixa.</p>
        </div>
    </header>

    <section class="card-panel mb-4">
        <div class="card-panel__header">
            <div class="record-name">
                <span class="record-name__icon"><i class="bi bi-funnel"></i></span>
                <div>
                    <span class="record-name__title">Filtros</span>
                    <span class="record-name__subtitle">Refine a busca por data</span>
                </div>
            </div>
        </div>

        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Data de fechamento inicial</label>
                    <input type="date" name="dataInicio" value="@Context.Request.Query["dataInicio"]" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Data de fechamento final</label>
                    <input type="date" name="dataFim" value="@Context.Request.Query["dataFim"]" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tipo de caixa</label>
                    <select name="tipoContribuicao" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var tipo in Enum.GetValues<TipoContribuicao>())
                        {
                            var selected = Context.Request.Query["tipoContribuicao"] == tipo.ToString() ? "selected" : "";
                            <option value="@tipo" selected="@selected">@tipo</option>
                        }
                    </select>
                </div>

                <div class="col-md-1 d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>
            </form>
        </div>
    </section>

    <section class="card-panel">
        <div class="card-panel__header">
            <div class="record-name">
                <span class="record-name__icon"><i class="bi bi-clipboard-data"></i></span>
                <div>
                    <span class="record-name__title">Fechamentos</span>
                    <span class="record-name__subtitle">@Model.Count() registro(s) encontrado(s)</span>
                </div>
            </div>
        </div>

        <div class="list-group list-group-flush">
            @if (!Model.Any())
            {
                <div class="list-group-item py-4 text-center text-muted">
                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                    Nenhum fechamento encontrado.
                </div>
            }

            @foreach (var item in Model)
            {
                <a asp-action="Movimento"
                   asp-controller="Caixa"
                   asp-route-id="@item.Id"
                   class="list-group-item list-group-item-action py-3 px-3">

                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark mb-1">
                                Movimento do caixa @item.TipoContribuicao
                            </div>

                            <small class="text-muted d-block">
                                <i class="bi bi-calendar-check me-1"></i>
                                Data de fechamento: @item.DtFechamento.ToString("dd/MM/yyyy")
                            </small>
                        </div>

                        <div class="text-muted">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>
</div>
