@using CleverWeb.Features.Caixa.ViewModels
@using System.Globalization
@using static CleverWeb.Data.Shared.Enums
@model RelatorioMovimentoCaixaViewModel

@{
    ViewData["Title"] = "Movimento do caixa";
    var filtro = Model.Filtro;
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-clipboard-data fs-3 text-primary me-2"></i>
        <h2 class="mb-0 fw-bold">Movimento do caixa</h2>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="Movimento" asp-route-id="@Model.Filtro.CaixaId" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Data inicial</label>
                    <input type="date" asp-for="Filtro.DataInicio" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Data final</label>
                    <input type="date" asp-for="Filtro.DataFim" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Tipo</label>
                    <select asp-for="Filtro.TipoContribuicao" asp-items="Html.GetEnumSelectList<TipoContribuicao>()" class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="col-md-1 d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                    <a asp-action="Movimento" asp-route-id="@Model.Filtro.CaixaId" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded-3 p-3 bg-light h-100">
                        <div class="text-muted small mb-1">Saldo anterior</div>
                        <div class="fs-5 fw-bold text-secondary">
                            @Model.Caixa.SaldoAnterior.ToString("C", new CultureInfo("pt-BR"))
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded-3 p-3 bg-success-subtle h-100">
                        <div class="text-success small mb-1">Saldo atual</div>
                        <div class="fs-4 fw-bold text-success">
                            @Model.Caixa.SaldoAtual.ToString("C", new CultureInfo("pt-BR"))
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                @if (!Model.Lista.Any())
                {
                    <div class="list-group-item py-4 text-center text-muted">
                        <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                        Nenhum movimento encontrado.
                    </div>
                }

                @foreach (var item in Model.Lista)
                {
                    <div class="list-group-item list-group-item-action py-3 px-3">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <div class="fw-semibold text-dark mb-1">@item.Origem</div>
                                <small class="text-muted d-block">@item.Descricao</small>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@item.Data.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <div class="text-end">
                                <span class="fw-bold @(item.Tipo == "Entrada" ? "text-success" : "text-danger")">
                                    @item.Valor.ToString("C", new CultureInfo("pt-BR"))
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<a asp-controller="Caixa"
   asp-action="ExportarPdf"
   asp-route-id="@Model.Filtro.CaixaId"
   class="btn btn-danger rounded-circle fab-action"
   aria-label="Gerar relatório"
   title="Gerar relatório">
    <i class="bi bi-file-earmark-pdf"></i>
</a>

<style>
    .fab-action {
        position: fixed;
        right: 20px;
        bottom: 90px;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        box-shadow: 0 10px 25px rgba(220, 53, 69, 0.35);
        z-index: 1030;
    }
</style>