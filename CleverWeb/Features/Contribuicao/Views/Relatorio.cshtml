@using CleverWeb.Features.Contribuicao.ViewModels
@using System.Globalization
@using static CleverWeb.Data.Shared.Enums
@model RelatorioContribuicaoViewModel

@{
    ViewData["Title"] = "Contribuições";
}

<div class="page-shell">
    <header class="section-header">
        <div>
            <div class="section-header__eyebrow">
                <i class="bi bi-cash-stack"></i>
                <span>Relatórios</span>
            </div>
            <h1 class="page-title">Relatório de contribuições</h1>
            <p class="section-header__description">Visualize os lançamentos por tipo, período e valor total.</p>
        </div>
    </header>

    <section class="card-panel mb-4">
        <div class="card-panel__header">
            <div class="record-name">
                <span class="record-name__icon"><i class="bi bi-funnel"></i></span>
                <div>
                    <span class="record-name__title">Filtros</span>
                    <span class="record-name__subtitle">Selecione o período da consulta</span>
                </div>
            </div>
        </div>

        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Tipo</label>
                        <select asp-for="Filtro.TipoContribuicao"
                                asp-items="Html.GetEnumSelectList<TipoContribuicao>()"
                                class="form-select">
                            <option value="">Todos</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Data inicial</label>
                        <input asp-for="Filtro.DataInicio" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Data final</label>
                        <input asp-for="Filtro.DataFim" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i> Filtrar
                        </button>

                        <button formaction="@Url.Action("ExportarPdf")"
                                formmethod="get"
                                class="btn btn-danger w-100">
                            <i class="bi bi-file-earmark-pdf me-1"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="card-panel mb-4 bg-light">
        <div class="card-body d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="record-name__icon bg-success-subtle text-success"><i class="bi bi-cash-coin"></i></span>
                <div>
                    <div class="text-muted small">Total do período</div>
                    <div class="fs-4 fw-bold text-success">
                        @Model.Lista.Sum(c => c.Valor).ToString("C", new CultureInfo("pt-BR"))
                    </div>
                </div>
            </div>

            <span class="badge text-bg-light border rounded-pill px-3 py-2">
                @Model.Lista.Count() registro(s)
            </span>
        </div>
    </section>

    <section class="card-panel">
        <div class="card-panel__header">
            <div class="record-name">
                <span class="record-name__icon"><i class="bi bi-list-ul"></i></span>
                <div>
                    <span class="record-name__title">Lançamentos</span>
                    <span class="record-name__subtitle">Detalhes de cada contribuição</span>
                </div>
            </div>
        </div>

        <div class="list-group list-group-flush">
            @if (!Model.Lista.Any())
            {
                <div class="list-group-item text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Nenhuma contribuição encontrada.
                </div>
            }
            else
            {
                @foreach (var item in Model.Lista)
                {
                    <div class="list-group-item py-3">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <div>
                                <div class="fw-semibold text-dark">
                                    @item.Membro.Nome
                                </div>

                                <div class="text-muted small mt-1">
                                    @item.TipoContribuicao
                                </div>

                                <div class="text-muted small mt-1">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    @item.DataLancamanto.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <div class="text-end">
                                <div class="fw-bold text-success fs-5">
                                    @item.Valor.ToString("C", new CultureInfo("pt-BR"))
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>
