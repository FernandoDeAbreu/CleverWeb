@using CleverWeb.Features.Dashboard.ViewModels
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var total = Model.SaldoCaixaDizimo + Model.SaldoCaixaOfertas + Model.SaldoCaixaMissao;
}

<div class="dashboard-shell">
    <div class="dashboard-header">
        <h1>Dashboard</h1>
    </div>


    <div class="dashboard-summary">
        <span class="dashboard-summary__label">Saldo total</span>
        <strong class="dashboard-summary__value">@total.ToString("C")</strong>
    </div>

    <div class="metric-grid">
        <div class="metric-card metric-card--primary">
            <div class="metric-card__icon">
                <i class="bi bi-piggy-bank-fill"></i>
            </div>
            <span class="metric-card__title">Dízimos</span>
            <span class="metric-card__value">@Model.SaldoCaixaDizimo.ToString("C")</span>
        </div>

        <div class="metric-card metric-card--warning">
            <div class="metric-card__icon">
                <i class="bi bi-gift-fill"></i>
            </div>
            <span class="metric-card__title">Ofertas</span>
            <span class="metric-card__value">@Model.SaldoCaixaOfertas.ToString("C")</span>
        </div>

        <div class="metric-card metric-card--success">
            <div class="metric-card__icon">
                <i class="bi bi-globe2"></i>
            </div>
            <span class="metric-card__title">Missões</span>
            <span class="metric-card__value">@Model.SaldoCaixaMissao.ToString("C")</span>
        </div>
    </div>

    <div class="panel">
        <div class="panel__header">
            <h2>Últimas atividades</h2>
        </div>
        <div class="panel__body">
            <div class="list-group list-group-flush activity-list">
                @foreach (var item in Model.Lista)
                {
                    <a class="list-group-item list-group-item-action">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="fw-semibold text-dark">@item.Origem</div>
                                <small class="text-muted d-block">@item.TipoContribuicao</small>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@item.Data.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <div class="text-end ms-3">
                                <span class="fw-bold @(item.Tipo == "Entrada" ? "text-success" : "text-danger")">
                                    @item.Valor.ToString("C")
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>