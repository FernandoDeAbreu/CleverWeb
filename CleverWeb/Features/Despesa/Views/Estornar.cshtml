@using System.Globalization
@model CleverWeb.Features.Despesa.ViewModels.DespesaViewModel

@{
    ViewData["Title"] = "Estornar despesa";
}

<div class="page-shell">
    <header class="section-header">
        <div>
            <div class="section-header__eyebrow">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Financeiro</span>
            </div>
            <h1 class="page-title">Estornar despesa</h1>
            <p class="section-header__description">Registre o motivo para desfazer este lançamento.</p>
        </div>
    </header>

    <section class="card-panel">
        <div class="card-panel__header">
            <div class="record-name">
                <span class="record-name__icon"><i class="bi bi-receipt"></i></span>
                <div>
                    <span class="record-name__title">@Model.Descricao</span>
                    <span class="record-name__subtitle">@Model.Valor.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</span>
                </div>
            </div>
        </div>

        <form asp-action="Estornar" method="post" class="form-card">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-1"></i>
                O valor será devolvido ao saldo atual do caixa, quando este lançamento estiver vinculado a um fechamento ativo.
            </div>

            <div class="mb-3">
                <label asp-for="MotivoExclusao" class="form-label fw-semibold"></label>
                <textarea asp-for="MotivoExclusao"
                          class="form-control"
                          rows="4"
                          minlength="15"
                          maxlength="500"
                          required
                          placeholder="Informe o motivo do estorno (mínimo de 15 caracteres)"></textarea>
                <div class="form-text">Informe pelo menos 15 caracteres.</div>
                <span asp-validation-for="MotivoExclusao" class="text-danger"></span>
            </div>

            <div class="form-actions d-flex justify-content-between gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Confirmar estorno
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
