@model CleverWeb.Features.Fornecedor.ViewModels.FornecedorViewModel

@{
    ViewData["Title"] = "Editar fornecedor";
}

<div class="page-shell">
    <div class="form-card">
        <div class="form-card__header">
            <span class="record-name__icon"><i class="bi bi-person-vcard"></i></span>
            <div>
                <div class="section-header__eyebrow">Cadastro financeiro</div>
                <h2>Editar fornecedor</h2>
                <p>Atualize os dados do fornecedor cadastrado.</p>
            </div>
        </div>

        <form asp-action="Edit" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section-title"><i class="bi bi-info-circle"></i> Identificação</div>

            <div class="row g-3">
                <div class="col-12">
                    <div class="form-floating">
                        <input asp-for="Descricao" class="form-control" maxlength="200" autofocus placeholder="Descrição" />
                        <label asp-for="Descricao"></label>
                    </div>
                    <span asp-validation-for="Descricao" class="text-danger small d-block mt-2"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>Salvar alterações
                </button>
                <button type="submit" formaction="@Url.Action("Delete", "Fornecedor", new { id = Model.Id })" formmethod="post" class="btn btn-danger ms-auto" onclick="return confirm('Deseja realmente excluir este fornecedor?');">
                    <i class="bi bi-trash3 me-1"></i>Excluir
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
