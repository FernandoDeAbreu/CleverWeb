@model IEnumerable<CleverWeb.Features.Fornecedor.ViewModels.FornecedorViewModel>

@{
    ViewData["Title"] = "Fornecedores";
}

<div class="page-shell">
    <div class="section-header">
        <div>
            <div class="section-header__eyebrow"><i class="bi bi-person-vcard"></i> Cadastro financeiro</div>
            <h1 class="page-title">Fornecedores</h1>
            <p class="section-header__description">Gerencie as origens das despesas da igreja.</p>
        </div>
    </div>

    <a asp-action="Create" class="fab-action" aria-label="Adicionar fornecedor">
        <i class="bi bi-plus-lg"></i>
    </a>

    @if (TempData["Success"] is string sucesso)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @sucesso
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (TempData["Error"] is string erro)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @erro
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="card-panel">
        <div class="card-panel__header">
            <strong>Fornecedores cadastrados</strong>
            <span class="card-panel__meta">@Model.Count() @(Model.Count() == 1 ? "fornecedor" : "fornecedores")</span>
        </div>
        <div class="table-responsive">
            <table class="table data-table mb-0">
                <thead>
                    <tr>
                        <th>Fornecedor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fornecedor in Model)
                    {
                        <tr class="clickable-row" data-href="@Url.Action("Edit", "Fornecedor", new { id = fornecedor.Id })">
                            <td>
                                <div class="record-name">
                                    <span class="record-name__icon"><i class="bi bi-person-vcard"></i></span>
                                    <span class="record-name__title">@fornecedor.Descricao</span>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td class="table-empty"><i class="bi bi-person-vcard"></i>Nenhum fornecedor cadastrado ainda.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.clickable-row[data-href]').forEach(function (row) {
            row.addEventListener('click', function () {
                window.location.href = row.dataset.href;
            });
        });
    </script>
}
