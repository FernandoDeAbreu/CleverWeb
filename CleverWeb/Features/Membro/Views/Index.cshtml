@using CleverWeb.Features.Membro.ViewModels
@model IEnumerable<MembroViewModel>

@{
    ViewData["Title"] = "Membros";
}

<div class="page-shell">
    <div class="section-header">
        <div>
            <div class="section-header__eyebrow"><i class="bi bi-people-fill"></i> Cadastro geral</div>
            <h1 class="page-title">Membros</h1>
            <p class="section-header__description">Gerencie os membros da igreja e suas informações cadastradas.</p>
        </div>
    </div>

    <a asp-action="Create" asp-controller="Membro" class="fab-action" aria-label="Adicionar membro">
        <i class="bi bi-person-plus-fill"></i>
    </a>

    <div class="card-panel">
        <div class="card-panel__header">
            <strong>Membros cadastrados</strong>
            <span class="card-panel__meta">@Model.Count() @(Model.Count() == 1 ? "membro" : "membros")</span>
        </div>

        <div class="table-responsive">
            <table class="table data-table mb-0">
                <thead>
                    <tr>
                        <th>Membro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string[] partes = item.Nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        string iniciais = string.Join("", partes.Take(2).Select(p => p[0])).ToUpper();

                        <tr class="clickable-row" data-href="@Url.Action("Edit", "Membro", new { id = item.Id })">
                            <td>
                                <div class="record-name">
                                    <span class="record-name__icon bg-primary-subtle text-primary">@iniciais</span>
                                    <span class="record-name__title">@item.Nome</span>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td class="table-empty"><i class="bi bi-people"></i>Nenhum membro cadastrado ainda.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.clickable-row[data-href]').forEach(function (row) {
            row.addEventListener('click', function () {
                window.location.href = row.dataset.href;
            });
        });
    </script>
}
