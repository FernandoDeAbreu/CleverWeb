@model CleverWeb.Features.Tenant.ViewModels.TenantViewModel

@{
    ViewData["Title"] = "Nova igreja";
}

<div class="page-shell">
    <div class="form-card">
        <div class="form-card__header">
            <span class="record-name__icon"><i class="bi bi-building-add"></i></span>
            <div>
                <div class="section-header__eyebrow">Nova unidade</div>
                <h2>Nova igreja</h2>
                <p>Cadastre uma igreja para organizar membros e acessos.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section-title"><i class="bi bi-info-circle"></i> Identificação</div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Endereco" class="form-label"></label>
                <input asp-for="Endereco" class="form-control" maxlength="250" />
                <span asp-validation-for="Endereco" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PastorCongregacional" class="form-label"></label>
                <input asp-for="PastorCongregacional" class="form-control" maxlength="150" />
                <span asp-validation-for="PastorCongregacional" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>
        </form>
    </div>
</div>
