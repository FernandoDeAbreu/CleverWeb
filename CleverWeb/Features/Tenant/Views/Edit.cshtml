@model CleverWeb.Features.Tenant.ViewModels.TenantViewModel

@{
    ViewData["Title"] = "Editar igreja";
}

<div class="page-shell">
    <div class="form-card">
        <div class="form-card__header">
            <span class="record-name__icon"><i class="bi bi-building-gear"></i></span>
            <div>
                <div class="section-header__eyebrow">Configuração da unidade</div>
                <h2>Editar igreja</h2>
                <p>Atualize a identificação e a disponibilidade desta igreja.</p>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section-title"><i class="bi bi-info-circle"></i> Identificação</div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Ativo" class="form-check-input" />
                <label asp-for="Ativo" class="form-check-label"></label>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
            </div>
        </form>
    </div>
</div>
