@model CleverWeb.Features.Tenant.ViewModels.TenantViewModel

@{
    ViewData["Title"] = "Editar igreja";
}

<div class="page-shell">
    <div class="form-card">
        <div class="form-card__header">
            <span class="record-name__icon"><i class="bi bi-building-gear"></i></span>
            <div>
                <div class="section-header__eyebrow">Configuração da unidade</div>
                <h2>Editar igreja</h2>
                <p>Atualize a identificação e a disponibilidade desta igreja.</p>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section-title"><i class="bi bi-info-circle"></i> Identificação</div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Endereco" class="form-label"></label>
                <input asp-for="Endereco" class="form-control" maxlength="250" />
                <span asp-validation-for="Endereco" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PastorCongregacional" class="form-label"></label>
                <input asp-for="PastorCongregacional" class="form-control" maxlength="150" />
                <span asp-validation-for="PastorCongregacional" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Ativo" class="form-check-input" />
                <label asp-for="Ativo" class="form-check-label"></label>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <button type="submit" formaction="@Url.Action("ToggleStatus", "Tenant", new { id = ViewContext.RouteData.Values["id"] })" formmethod="post" class="btn @(Model.Ativo ? "btn-secondary" : "btn-success")">
                    <i class="bi @(Model.Ativo ? "bi-pause-circle" : "bi-play-circle") me-1"></i>@(Model.Ativo ? "Desativar" : "Ativar")
                </button>
                <button type="submit" formaction="@Url.Action("Delete", "Tenant", new { id = ViewContext.RouteData.Values["id"] })" formmethod="post" class="btn btn-danger" onclick="return confirm('Deseja realmente excluir esta igreja?');">
                    <i class="bi bi-trash3 me-1"></i>Excluir
                </button>
            </div>
        </form>
    </div>
</div>
