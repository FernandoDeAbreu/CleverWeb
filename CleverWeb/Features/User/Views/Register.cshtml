@model CleverWeb.Features.Users.ViewModels.RegisterUserViewModel

@{
    ViewData["Title"] = "Novo usuário";
}

<div class="page-shell">
    <div class="form-card">
        <div class="form-card__header">
            <span class="record-name__icon"><i class="bi bi-person-plus-fill"></i></span>
            <div>
                <div class="section-header__eyebrow">Novo acesso</div>
                <h2>Novo usuário</h2>
                <p>Crie uma conta vinculada a um membro da igreja.</p>
            </div>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section-title"><i class="bi bi-person-vcard"></i> Dados da conta</div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            @if (User.HasClaim("is_global_admin", "true"))
            {
                <div class="mb-3">
                    <label asp-for="TenantId" class="form-label"></label>
                    <select asp-for="TenantId" asp-items="Model.TenantOptions" class="form-select" id="TenantId">
                        <option value="">Selecione a igreja/tenant</option>
                    </select>
                    <span asp-validation-for="TenantId" class="text-danger"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="MembroId" class="form-label"></label>
                <select asp-for="MembroId" asp-items="Model.MembroOptions" class="form-select" id="MembroId">
                    <option value="">Selecione o membro</option>
                </select>
                <span asp-validation-for="MembroId" class="text-danger"></span>
            </div>

            <div class="form-section-title"><i class="bi bi-shield-lock"></i> Segurança</div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label"></label>
                <input asp-for="Senha" class="form-control" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarSenha" class="form-label"></label>
                <input asp-for="ConfirmarSenha" class="form-control" />
                <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Cadastrar</button>
            </div>
        </form>
    </div>
</div>

@if (User.HasClaim("is_global_admin", "true"))
{
    <script>
        const tenantSelect = document.getElementById('TenantId');
        const membroSelect = document.getElementById('MembroId');

        tenantSelect.addEventListener('change', async function () {
            const tenantId = this.value;
            membroSelect.innerHTML = '<option value="">Selecione o membro</option>';
            membroSelect.disabled = !tenantId;

            if (!tenantId) {
                return;
            }

            const response = await fetch('@Url.Action("MembrosPorTenant", "User")?tenantId=' + encodeURIComponent(tenantId));
            if (!response.ok) {
                membroSelect.disabled = true;
                return;
            }

            const membros = await response.json();
            membros.forEach(function (membro) {
                const option = document.createElement('option');
                option.value = membro.id;
                option.textContent = membro.nome;
                membroSelect.appendChild(option);
            });

            membroSelect.disabled = false;
        });
    </script>
}
