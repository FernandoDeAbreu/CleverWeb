@{
    var tenantName = ViewContext.HttpContext.User.FindFirst("tenant_name")?.Value ?? "CleverWeb";
    var usuarioLogado = ViewContext.HttpContext.User.FindFirst("member_name")?.Value
        ?? ViewContext.HttpContext.User.Identity?.Name
        ?? "Usuário";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @tenantName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <!-- NAVBAR SUPERIOR -->
    <nav class="navbar navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-people-fill me-2"></i> @tenantName.ToUpperInvariant()
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-light text-primary px-3 py-2 fw-semibold">
                        <i class="bi bi-person-circle me-1"></i>@usuarioLogado
                    </span>

                    <a asp-controller="Membro" asp-action="Index" class="btn btn-sm btn-light text-primary fw-semibold">
                        Membros
                    </a>
                    <a asp-controller="Caixa" asp-action="Fechamento" class="btn btn-sm btn-light text-primary fw-semibold">
                        Fechar caixa
                    </a>
                    <a asp-controller="Caixa" asp-action="Index" class="btn btn-sm btn-light text-primary fw-semibold">
                        Relatório de caixa
                    </a>
                    <a asp-controller="Contribuicao" asp-action="Relatorio" class="btn btn-sm btn-light text-primary fw-semibold">
                        Relatório de lançamentos
                    </a>

                    <a asp-controller="User" asp-action="Index" class="btn btn-sm btn-light text-primary fw-semibold">
                        Usuários
                    </a>

                    @if (User.HasClaim("is_global_admin", "true"))
                    {
                        <a asp-controller="Tenant" asp-action="Index" class="btn btn-sm btn-light text-primary fw-semibold">
                            Igrejas
                        </a>
                    }

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light text-white border-white">
                            <i class="bi bi-box-arrow-right me-1"></i> Sair
                        </button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <!-- CONTEÚDO -->
    <main class="container py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm text-center">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- NAVBAR INFERIOR -->
    <nav class="navbar bg-white fixed-bottom shadow-sm border-top">
        <div class="container-fluid justify-content-around text-center">
            <a asp-controller="Dashboard" asp-action="Index" class="text-dark text-decoration-none">
                <i class="bi bi-house-fill fs-4"></i>
                <div class="small">Início</div>
            </a>
            <a asp-controller="Contribuicao" asp-action="MembroList" class="text-dark text-decoration-none">
                <i class="bi bi-cash-stack fs-4"></i>
                <div class="small">Contribuições</div>
            </a>
            <a asp-controller="Despesa" asp-action="Index" class="text-dark text-decoration-none">
                <i class="bi bi-upc-scan fs-4"></i>
                <div class="small">Despesas</div>
            </a>
            <a asp-controller="Home" asp-action="Index" class="text-dark text-decoration-none">
                <i class="bi bi-node-plus fs-4"></i>
                <div class="small">Mais</div>
            </a>
        </div>
    </nav>

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }

        main {
            padding-bottom: 80px; /* espaço para não ficar escondido atrás da navbar inferior */
        }

        .navbar.fixed-bottom i {
            font-size: 1.5rem;
        }

        .navbar.fixed-bottom div {
            font-size: 0.75rem;
        }

        .quick-menu {
            background: #ffffff;
            border: 1px solid #e7edf5;
            border-radius: 1rem;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
            padding: 0.85rem;
        }

        .quick-menu__grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.85rem;
        }

        .quick-menu__item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 0.9rem;
            border-radius: 0.9rem;
            background: #f8fafc;
            color: #1f2937;
            text-decoration: none;
            border: 1px solid #edf2f7;
            transition: all 0.2s ease;
            font-weight: 600;
        }

        .quick-menu__item:hover {
            background: #eef4ff;
            border-color: #dbeafe;
            transform: translateY(-1px);
            text-decoration: none;
            color: #1f2937;
        }

        .quick-menu__icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: #e8f1ff;
            color: #0d6efd;
            flex-shrink: 0;
        }

        .alert {
            border-radius: 12px;
        }

        @@media (max-width: 767.98px) {
            .quick-menu__grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>