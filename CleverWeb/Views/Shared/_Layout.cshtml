@{
    var tenantName = ViewContext.HttpContext.User.FindFirst("tenant_name")?.Value ?? "CleverWeb";
    var usuarioLogado = ViewContext.HttpContext.User.FindFirst("member_name")?.Value
        ?? ViewContext.HttpContext.User.Identity?.Name
        ?? "Usuário";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @tenantName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <nav class="navbar navbar-dark bg-primary shadow-sm topbar">
        <div class="container-fluid px-3">
            <div class="topbar__brand">
                <a class="navbar-brand fw-bold d-flex align-items-center m-0" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-people-fill me-2"></i>
                    <span>@tenantName</span>
                </a>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="topbar__user">
                    <i class="bi bi-person-circle me-2"></i>
                    <span>@usuarioLogado</span>
                </div>
            }
        </div>
    </nav>

    <main class="container py-3 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm text-center">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <nav class="navbar bg-white fixed-bottom shadow-sm border-top bottom-nav">
        <div class="container-fluid justify-content-around text-center px-2">
            <a asp-controller="Dashboard" asp-action="Index" class="bottom-nav__item">
                <i class="bi bi-house-fill"></i>
                <span>Início</span>
            </a>
            <a asp-controller="Contribuicao" asp-action="MembroList" class="bottom-nav__item">
                <i class="bi bi-cash-stack"></i>
                <span>Contribuições</span>
            </a>
            <a asp-controller="Despesa" asp-action="Index" class="bottom-nav__item">
                <i class="bi bi-upc-scan"></i>
                <span>Despesas</span>
            </a>
            <button type="button" class="bottom-nav__item bottom-nav__toggle" data-menu-toggle aria-expanded="false">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <span>Mais</span>
            </button>
        </div>
    </nav>

    <div id="mainMenuPanel" class="main-menu-panel" aria-hidden="true">
        <div class="main-menu-panel__header">
            <span>Menu principal</span>
            <button type="button" class="main-menu-panel__close" data-menu-close aria-label="Fechar menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="main-menu-panel__list">
            <a asp-controller="Membro" asp-action="Index" class="main-menu-panel__item">
                <i class="bi bi-people-fill"></i>
                <span>Membros</span>
            </a>
            <a asp-controller="Caixa" asp-action="Fechamento" class="main-menu-panel__item">
                <i class="bi bi-bank"></i>
                <span>Fechar caixa</span>
            </a>
            <a asp-controller="Caixa" asp-action="Index" class="main-menu-panel__item">
                <i class="bi bi-file-bar-graph"></i>
                <span>Relatório de caixa</span>
            </a>
            <a asp-controller="Contribuicao" asp-action="Relatorio" class="main-menu-panel__item">
                <i class="bi bi-file-earmark-text"></i>
                <span>Relatório de lançamentos</span>
            </a>
            <a asp-controller="User" asp-action="Index" class="main-menu-panel__item">
                <i class="bi bi-person-gear"></i>
                <span>Usuários</span>
            </a>
            @if (User.HasClaim("is_global_admin", "true"))
            {
                <a asp-controller="Tenant" asp-action="Index" class="main-menu-panel__item">
                    <i class="bi bi-building"></i>
                    <span>Igrejas</span>
                </a>
            }
            <form asp-controller="Auth" asp-action="Logout" method="post" class="main-menu-panel__logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="main-menu-panel__item main-menu-panel__item--logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Sair</span>
                </button>
            </form>
        </div>
    </div>

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }

        main {
            padding-bottom: 92px;
        }

        .topbar {
            min-height: 68px;
        }

        .topbar__brand {
            display: flex;
            align-items: center;
        }

        .topbar__brand .navbar-brand {
            font-size: 1rem;
            letter-spacing: 0.02em;
        }

        .topbar__user {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;
            padding: 0.45rem 0.8rem;
            color: #fff;
            font-size: 0.82rem;
            font-weight: 600;
            max-width: 58vw;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .bottom-nav {
            min-height: 72px;
            padding: 0.25rem 0;
        }

        .bottom-nav__item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.2rem;
            color: #475569;
            text-decoration: none;
            background: transparent;
            border: 0;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.4rem 0.2rem;
        }

        .bottom-nav__item i {
            font-size: 1.4rem;
        }

        .bottom-nav__item.active,
        .bottom-nav__item:hover {
            color: #0d6efd;
        }

        .bottom-nav__toggle {
            color: #475569;
        }

        .main-menu-panel {
            position: fixed;
            right: 0;
            bottom: 72px;
            left: 0;
            z-index: 1030;
            background: rgba(15, 23, 42, 0.25);
            backdrop-filter: blur(3px);
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            pointer-events: none;
        }

        .main-menu-panel.show {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .main-menu-panel__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
            color: #fff;
            padding: 0.8rem 1rem;
            font-weight: 700;
        }

        .main-menu-panel__close {
            background: transparent;
            border: 0;
            color: #fff;
            font-size: 1.1rem;
        }

        .main-menu-panel__list {
            background: #fff;
            border-top: 1px solid #e7edf5;
            padding: 0.75rem;
            display: grid;
            gap: 0.5rem;
        }

        .main-menu-panel__item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            width: 100%;
            border: 1px solid #edf2f7;
            border-radius: 0.8rem;
            background: #f8fafc;
            color: #1f2937;
            text-decoration: none;
            padding: 0.9rem 1rem;
            font-weight: 600;
        }

        .main-menu-panel__item i {
            color: #0d6efd;
            font-size: 1.1rem;
        }

        .main-menu-panel__item--logout {
            background: #fff5f5;
            border-color: #fecaca;
            color: #b42318;
        }

        .main-menu-panel__item--logout i {
            color: #b42318;
        }

        .main-menu-panel__logout {
            margin: 0;
        }

        .main-menu-panel__logout button {
            border: 1px solid #fecaca;
        }

        .alert {
            border-radius: 12px;
        }

        @@media (min-width: 768px) {
            .topbar__brand .navbar-brand {
                font-size: 1.1rem;
            }

            .topbar__user {
                max-width: none;
            }

            .main-menu-panel {
                left: auto;
                width: min(420px, 92vw);
                right: 1rem;
                bottom: 88px;
            }
        }
    </style>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            const toggleButton = document.querySelector('[data-menu-toggle]');
            const panel = document.getElementById('mainMenuPanel');
            const closeButton = document.querySelector('[data-menu-close]');

            if (!toggleButton || !panel) return;

            const setMenuState = function (isOpen) {
                panel.classList.toggle('show', isOpen);
                panel.setAttribute('aria-hidden', String(!isOpen));
                toggleButton.setAttribute('aria-expanded', String(isOpen));
            };

            toggleButton.addEventListener('click', function () {
                const isOpen = panel.classList.contains('show');
                setMenuState(!isOpen);
            });

            if (closeButton) {
                closeButton.addEventListener('click', function () {
                    setMenuState(false);
                });
            }

            panel.addEventListener('click', function (event) {
                if (event.target === panel) {
                    setMenuState(false);
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    setMenuState(false);
                }
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>